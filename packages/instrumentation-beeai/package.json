{
  "name": "@opentelemetry/instrumentation-beeai",
  "version": "0.1.0",
  "description": "OpenTelemetry instrumentation for the `beeai-framework` library",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-telemetry/opentelemetry-js-contrib.git",
    "directory": "packages/instrumentation-beeai"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "compile:with-dependencies": "nx run-many -t compile -p @opentelemetry/instrumentation-beeai",
    "compile": "tsdown",
    "lint:readme": "node ../../scripts/lint-readme.js",
    "prepublishOnly": "npm run compile",
    "tdd": "npm test -- --watch --watch-files \"**/*.ts\"",
    "test": "nyc --no-clean mocha --require '@opentelemetry/contrib-test-utils' 'test/**/*.test.ts'",
    "test-all-versions": "tav",
    "test:conformance": "otel-conformance test/conformance --report-dir coverage/conformance --data-file coverage/conformance-data.json",
    "version:update": "node ../../scripts/version-update.js",
    "watch": "tsdown --watch --no-clean"
  },
  "keywords": [
    "beeai",
    "beeai-framework",
    "instrumentation",
    "opentelemetry",
    "llm",
    "agents",
    "genai"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/contrib-test-utils": "^0.72.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "beeai-framework": "0.1.13"
  },
  "dependencies": {
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/genai-util": "^0.5.0",
    "@opentelemetry/instrumentation": "^0.301.0"
  },
  "homepage": "https://github.com/open-telemetry/opentelemetry-js-contrib/tree/main/packages/instrumentation-beeai#readme"
}
